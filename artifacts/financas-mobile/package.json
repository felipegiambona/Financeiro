{
  "name": "@workspace/financas-mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "sh -c 'if [ -n \"$REPLIT_EXPO_SESSION_SECRET\" ]; then pnpm exec create-launch login --session \"$REPLIT_EXPO_SESSION_SECRET\" || true; fi' && EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=$CLERK_PUBLISHABLE_KEY EXPO_PACKAGER_PROXY_URL=https://$REPLIT_EXPO_DEV_DOMAIN EXPO_PUBLIC_DOMAIN=$REPLIT_DEV_DOMAIN EXPO_PUBLIC_REPL_ID=$REPL_ID REACT_NATIVE_PACKAGER_HOSTNAME=$REPLIT_DEV_DOMAIN pnpm exec expo start --localhost --port $PORT",
    "build": "node scripts/build.js",
    "serve": "node server/serve.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:financial-rules": "../api-server/node_modules/.bin/esbuild test/financialRules.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-financialRules.test.mjs && node --test /tmp/financas-mobile-financialRules.test.mjs",
    "test:pending-notifications": "../api-server/node_modules/.bin/esbuild test/pendingNotifications.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-pendingNotifications.test.mjs && node --test /tmp/financas-mobile-pendingNotifications.test.mjs",
    "test:investment-composition": "../api-server/node_modules/.bin/esbuild test/investmentComposition.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-investmentComposition.test.mjs && node --test /tmp/financas-mobile-investmentComposition.test.mjs",
    "test:onboarding": "../api-server/node_modules/.bin/esbuild test/onboardingState.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-onboardingState.test.mjs && node --test /tmp/financas-mobile-onboardingState.test.mjs",
    "test:recent-assets": "../api-server/node_modules/.bin/esbuild test/recentInvestmentAssets.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-recent-assets.test.mjs && node --test /tmp/financas-mobile-recent-assets.test.mjs",
    "test:card-invoice-filters": "../api-server/node_modules/.bin/esbuild test/cardInvoiceFilters.test.mjs --bundle --platform=node --format=esm --outfile=/tmp/financas-mobile-cardInvoiceFilters.test.mjs && node --test /tmp/financas-mobile-cardInvoiceFilters.test.mjs",
    "test:error-fallback": "trap 'rm -f test/.errorFallback.test.mjs' EXIT; ../api-server/node_modules/.bin/esbuild test/errorFallback.test.mjs --bundle --platform=node --format=esm --define:__DEV__=true --external:react --external:react-dom/server --alias:react-native=./test/mocks/react-native.mjs --alias:@expo/vector-icons=./test/mocks/vector-icons.mjs --alias:expo=./test/mocks/expo.mjs --outfile=test/.errorFallback.test.mjs && node --test test/.errorFallback.test.mjs"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@clerk/expo": "^4.6.5",
    "@expo-google-fonts/inter": "^0.4.0",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native/metro-config": "0.86.3",
    "@stardazed/streams-text-encoding": "^1.0.2",
    "@tanstack/react-query": "5.101.4",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.4",
    "@ungap/structured-clone": "^1.3.0",
    "@workspace/api-client-react": "workspace:*",
    "babel-plugin-react-compiler": "^19.0.0-beta-e993439-20250117",
    "create-launch": "0.3.6",
    "expo": "~57.0.22",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.17",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "metro-runtime": "0.83.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zod": "catalog:",
    "zod-validation-error": "^3.4.0"
  },
  "dependencies": {
    "expo-auth-session": "~57.0.12",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "57.0.7",
    "expo-navigation-bar": "~57.0.2",
    "expo-print": "57.0.2",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "57.0.19"
  }
}
