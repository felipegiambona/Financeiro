{
  "expo": {
    "name": "Finanças Mobile",
    "slug": "financas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "financas-mobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#090909",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.financas.mobile"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "style": "light"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
